# Database (SQLite) — datasets metadata, conversations, messages
AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider = Google Gemini (auto-detected from the key below)
# AGENT_LLM_PROVIDER=gemini
# AGENT_LLM_MODEL=gemini-3.1-pro-preview   (effective default until GA gemini-3.1-pro ships)
AGENT_GEMINI_API_KEY=

# Analysis loop tuning (optional — sensible defaults applied when blank)
# AGENT_SAMPLE_ROWS=20         rows sampled to the LLM (never the full dataset)
# AGENT_MAX_ATTEMPTS=3         iterate/self-correct cap
# AGENT_EXEC_TIMEOUT_S=25      pandas sandbox wall-clock timeout (seconds)

PORT=8001
